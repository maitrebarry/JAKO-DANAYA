{
  "expo": {
    "name": "JÀGO DÁNAYA",
    "slug": "jago-danaya-mobile",
    "version": "0.1.0",
    "icon": "./src/assets/logo.png",
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "com.jagodanana.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.jagodanana.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "JÀGO DÁNAYA a besoin d'accéder à la caméra pour scanner les codes-barres."
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "ade94f67-96c3-412d-8e1d-f4a215a55528"
      }
    },
    "owner": "maitrebarry"
  }
}
