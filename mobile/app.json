{
  "expo": {
    "name": "JÀGO DÁNAYA",
    "slug": "jago-danaya-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "com.jagodanana.mobile",
      "permissions": [
        "CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.jagodanana.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "JÀGO DÁNAYA a besoin d'accéder à la caméra pour scanner les codes-barres."
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      "expo-web-browser"
    ]
  }
}
