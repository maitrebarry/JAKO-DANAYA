@startuml JAKO-DANAYA_detail_A_administration
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam actorStyle awesome
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2C5F8A
  FontSize 12
  ArrowColor #4A6A80
}
skinparam package {
  BackgroundColor #FDFEFE
  BorderColor #7F97A8
  FontStyle bold
  FontSize 13
}
skinparam actor {
  BackgroundColor #FFF3E0
  BorderColor #B36B00
  FontSize 12
}
skinparam ArrowFontSize 10
title Cas d'utilisation détaillés (1/3) - Authentification, Utilisateurs & Configuration

actor "Personnel\n(tout utilisateur connecté)" as Personnel
actor "Gérant" as Gerant
actor "Administrateur\nde boutique" as Admin
actor "Super\nAdministrateur" as SuperAdmin

Admin --|> Personnel
Gerant --|> Personnel
SuperAdmin --|> Admin

rectangle "Système JAKO-DANAYA" {
  package "Authentification & Compte" {
    usecase "Se connecter" as UC_Login
    usecase "Se déconnecter" as UC_Logout
    usecase "Mot de passe oublié" as UC_ForgotPwd
    usecase "Réinitialiser le mot de passe" as UC_ResetPwd
    usecase "Modifier son profil" as UC_EditProfile
    usecase "Changer son mot de passe" as UC_ChangePwd
  }

  package "Utilisateurs & Accès" {
    usecase "Gérer les utilisateurs" as UC_ManageUsers
    usecase "Activer / désactiver\nun utilisateur" as UC_ToggleUser
    usecase "Gérer les rôles" as UC_ManageRoles
    usecase "Assigner des permissions" as UC_AssignPerms
  }

  package "Boutiques & Configuration" {
    usecase "Gérer les boutiques" as UC_ManageBoutiques
    usecase "Gérer les magasins / dépôts" as UC_ManageMagasins
    usecase "Sélectionner la\nboutique active" as UC_SelectBoutique
    usecase "Configurer les marges" as UC_ConfigMarges
    usecase "Gérer les unités de mesure" as UC_ManageUnites
  }
}

Personnel -- UC_Login
Personnel -- UC_Logout
Personnel -- UC_EditProfile
Personnel -- UC_ChangePwd

Gerant -- UC_ManageUsers
Gerant -- UC_ToggleUser
Gerant -- UC_ManageMagasins

Admin -- UC_ManageRoles
Admin -- UC_AssignPerms
Admin -- UC_ConfigMarges
Admin -- UC_ManageUnites
Admin -- UC_ManageUsers
Admin -- UC_ToggleUser

SuperAdmin -- UC_ManageBoutiques
SuperAdmin -- UC_ManageMagasins
SuperAdmin -- UC_SelectBoutique

UC_Login .> UC_ForgotPwd : <<extend>>
UC_ForgotPwd .> UC_ResetPwd : <<include>>
UC_ManageUsers .> UC_AssignPerms : <<extend>>

@enduml
