# Frontend environment variables
# Local development (Vite) - default used by the app when VITE_API_URL is not provided:
VITE_API_URL=https://api.example.com  # replace with your backend URL (or keep http://localhost:8085 for local dev)

# In production, set VITE_API_URL to your backend URL (example for Render):
# VITE_API_URL=https://ton-backend.onrender.com
